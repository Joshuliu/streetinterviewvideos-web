# Meta (Facebook) Pixel / Dataset ID. Public by design (ships to the browser);
# kept in an env var so it can be rotated without a code change.
# Set this in Vercel project env vars for Production + Preview.
NEXT_PUBLIC_FB_PIXEL_ID=1117354679872784

# Meta Conversions API (server-side) access token. SECRET — server-only, never
# prefixed NEXT_PUBLIC. Generate a System User token in Meta Events Manager →
# Settings → Conversions API ("Generate access token") for dataset
# 1117354679872784. While unset, server-side CAPI is dormant and the funnel
# falls back to browser-pixel-only (nothing breaks). When set, /api/capi mirrors
# CompleteRegistration + Schedule server-side, deduped with the browser pixel.
META_CAPI_TOKEN=

# Optional: paste the code from Events Manager → Test events to verify CAPI
# events land there during testing. Leave blank in production.
META_CAPI_TEST_EVENT_CODE=

# Optional: destination for captured leads from /api/lead (Google Apps Script
# Web App, Zapier/Make catch hook, CRM endpoint). Unset = leads are logged only.
LEAD_WEBHOOK_URL=

# Optional: Telegram alert when a lead comes in (new lead + when they book a
# call). Both must be set or alerts no-op. See lib/telegram.ts for how to get
# the chat id. Server-only — never NEXT_PUBLIC.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
